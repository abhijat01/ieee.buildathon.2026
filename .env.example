# This profile uses dedicated ports and a dedicated authentik client.
APP_PROFILE=sample-app-02
APP_ORIGIN=http://localhost:5300
SERVER_PORT=8300
OIDC_ISSUER=http://localhost:9010/application/o/sample-app-02/
OIDC_CLIENT_ID=sample-app-02
OIDC_CLIENT_SECRET=
# Azure values default to the _secrets section of this local file.
AGENT_DEPLOYMENT_FILE=~/.agent.config/deployment.ini
# Optional overrides; keep the API key private.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
